# Copy this file to tools/web-media/.env or export the variables in your shell.
# Never commit real API keys.

# MoneyPrinterTurbo / LLM
MPT_LLM_PROVIDER=moonshot
MPT_LLM_API_KEY=
MPT_LLM_BASE_URL=
MPT_LLM_MODEL_NAME=

# Licensed stock providers
MPT_PEXELS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional OpenAI-compatible services used by selected apps
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional speech services
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=

# Asset policy. Keep strict unless you have explicit permission.
WEB_MEDIA_ALLOWED_RIGHTS=public-domain,cc0,cc-by,cc-by-sa,provider-licensed,user-owned,permission-granted
