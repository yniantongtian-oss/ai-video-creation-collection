# Long-form video LLM (OpenAI-compatible chat completions)
LONGFORM_LLM_BASE_URL=
LONGFORM_LLM_API_KEY=
LONGFORM_LLM_MODEL=
LONGFORM_LLM_TEMPERATURE=0.3
LONGFORM_LLM_TIMEOUT_SECONDS=180
LONGFORM_LLM_MAX_RETRIES=3

# Narration
LONGFORM_TTS_PROVIDER=edge-tts
LONGFORM_TTS_VOICE=zh-CN-XiaoxiaoNeural
LONGFORM_TTS_RATE=+0%
LONGFORM_TTS_VOLUME=+0%
LONGFORM_TTS_MAX_CHARS=1800

# Rendering
LONGFORM_WIDTH=1920
LONGFORM_HEIGHT=1080
LONGFORM_FPS=30
LONGFORM_VIDEO_BITRATE=8000k
LONGFORM_AUDIO_BITRATE=192k
LONGFORM_PRESET=medium
LONGFORM_VISUAL_SECONDS=10
LONGFORM_BGM_VOLUME=0.08
LONGFORM_BURN_SUBTITLES=false

# Workload and safety
LONGFORM_CHAPTER_MINUTES=7
LONGFORM_CHARS_PER_MINUTE=260
LONGFORM_RETRIEVAL_CHUNKS=12
LONGFORM_MAX_PARALLEL_DOWNLOADS=3
LONGFORM_ALLOWED_RIGHTS=public-domain,cc0,cc-by,cc-by-sa,provider-licensed,user-owned,permission-granted
